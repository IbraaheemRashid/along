// Copy to Secrets.xcconfig (gitignored) and fill real values for Release / TestFlight.
// Xcode: Along target → Build Settings → set these as user-defined settings, or
// `#include? "Secrets.xcconfig"` from a shared xcconfig once you add one.

ALONG_BILLING_ANNUAL_PRODUCT_ID = your.annual.product.id
ALONG_BILLING_MONTHLY_PRODUCT_ID = your.monthly.product.id
ALONG_SUPERWALL_PUBLIC_KEY = pk_your_superwall_public_key
ALONG_BILLING_ENTITLEMENT_ID = along.membership
ALONG_TERMS_URL = https://your.domain/terms
ALONG_PRIVACY_URL = https://your.domain/privacy
